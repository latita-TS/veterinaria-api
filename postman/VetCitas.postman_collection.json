{
  "info": {
    "name": "VetCitas API - Clínica Veterinaria",
    "description": "Pruebas del login (JWT + BCrypt) y del CRUD de citas. Ejecuta primero '1. Login' para guardar el token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "citaId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Monitoreo (DevOps)",
      "item": [
        {
          "name": "GET - Estado de la API (health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Estado UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "1. Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Devuelve token', () => pm.expect(r.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', r.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login incorrecto (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"equivocada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Login campos vacíos (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"recepcion1\",\n  \"password\": \"clave123\",\n  \"nombreCompleto\": \"Rosa Díaz\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201 o 400 si ya existe', () => pm.expect(pm.response.code).to.be.oneOf([201,400]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Citas (CRUD)",
      "item": [
        {
          "name": "POST - Registrar cita",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/citas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "citas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreMascota\": \"Firulais\",\n  \"especie\": \"Perro\",\n  \"nombreDueno\": \"Juan Pérez\",\n  \"telefonoDueno\": \"987654321\",\n  \"fechaHora\": \"2026-12-15T10:30\",\n  \"motivo\": \"Vacuna antirrábica\",\n  \"veterinario\": \"Dra. Ana Torres\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('citaId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
